# ============================================================
# HOPEHUB Backend Environment Configuration Template
# Copy this file to .env and configure for your local environment.
# NEVER commit .env to version control!
# ============================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8)
# Uses dedicated hopehub_user, NEVER root!
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hopehub_db
DB_USERNAME=hopehub_user
DB_PASSWORD=your_secure_application_password_here

# JPA / Hibernate Configuration
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Flyway Migration
FLYWAY_ENABLED=true

# Security / JWT Configuration (Min 256-bit / 32-byte secret)
JWT_SECRET=replace_with_a_secure_random_base64_or_hex_key_at_least_256_bits_long
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Application Mode
APP_SIMULATED_PAYMENTS=true
